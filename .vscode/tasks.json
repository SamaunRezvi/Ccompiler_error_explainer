{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "1. Build and Analyze Playground",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\start_here.ps1"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "2. Check GCC and GDB Setup",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\check_setup.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "3. Build Offline Explainer",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\build_offline.ps1"
      ],
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "4. Analyze Current C File",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\run_current_file.ps1",
        "-SourceFile",
        "${file}"
      ],
      "problemMatcher": []
    },
    {
      "label": "5. Run Project Tests",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\scripts\\test_project.ps1"
      ],
      "problemMatcher": []
    }
  ]
}
